Q) write a program for sorting a array by using insertion sort
Ans)

#include <iostream>
using namespace std;
int main()
{


int arr[5]={5,4,3,2,1};
int n=5;
 
for(int i=1; i<n; i++)

{
for(int j=i; j>0; j--)

 {

    if(arr[j]< arr[j-1])
    {

        swap(arr[j],arr[j-1]);
    }
 }

}

for(int i=0; i<n; i++)

{
cout<<arr[i]<<" ";

}

return 0;


}

// time complexity= o(n^2)
