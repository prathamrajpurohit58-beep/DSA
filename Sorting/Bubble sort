Q) write a program for sortinng a array using bubble sort
Ans)

#include <iostream>
using namespace std;
int main()
{
    int arr[7] = {2, 6, 4, 3, 8, 5, 1};
    int n = 7;
    for (int i = 1; i < n; i++)

    {
        for (int j = 0; i <= n - 2; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                swap(arr[j], arr[j + 1]);
            }
        }
    }
    for (int i = 0; i < n; i++)

    {
        cout << arr[i] << " ";
    }

    return 0;
}
